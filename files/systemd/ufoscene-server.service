[Unit]
Description=ufoscene server (TV page, phone remote)
After=network.target

[Service]
User=@USER@
Environment=XDG_RUNTIME_DIR=/run/user/@KUID@
ExecStart=/usr/bin/python3 @PREFIX@/server.py --port 80 --www @PREFIX@/www --ufo @PREFIX@/ufo
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
